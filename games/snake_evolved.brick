# snake_evolved.brick - Snake con tres niveles: BABY (150 ms), ENTUSIASTA (100 ms) y NYAN_CAT (75 ms)
# Los TICK siguen el plan (Nyan Cat = la mitad de Baby) y son multiplos de 25 ms. Si se ajustan jugando,
# mantener multiplos de 25 y que NYAN_CAT < ENTUSIASTA < BABY.
GAME_TYPE SNAKE

GAME_GRID (18, 18)

# --- Definicion de Elementos ---
DEFINE SHAPE PIXEL:
  STATE 1:
    [1]
END

# FORM: RECTANGLE (por defecto) | CIRCULAR | TRIANGULAR
DEFINE SHAPE SNAKE_BODY:
  FORM: CIRCULAR
  COLOR: #00FF00
END

DEFINE SHAPE POISON_FRUIT:
  COLOR: #8A2BE2
  PENALTY: 10
END

DEFINE SHAPE CLOUD:
  COLOR: #DDDDDD
  COUNT: 6
END

# Fruta "No Morir": DURATION = segundos de invulnerabilidad
DEFINE SHAPE SHIELD_FRUIT:
  COLOR: #FFD700
  DURATION: 8
END

# --- Niveles ---
# TICK en milisegundos (usar multiplos de 25). POISON: OFF | SUBTRACT | KILL
# SHIELD y CLOUDS: ON | OFF. HEAD: NORMAL | CAT. TAIL: NORMAL | RAINBOW
DEFINE LEVELS:
  DEFAULT_LEVEL: BABY
  LEVEL_UP_SCORE: 50
  LEVEL BABY:
    TICK: 150
  LEVEL ENTUSIASTA:
    TICK: 100
    POISON: SUBTRACT
    SHIELD: ON
  LEVEL NYAN_CAT:
    TICK: 75
    POISON: SUBTRACT
    SHIELD: ON
    CLOUDS: ON
    HEAD: CAT
    TAIL: RAINBOW
END

# --- Logica y Reglas ---
ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
END

# ON_TICK es un evento que se ejecuta en cada ciclo del juego
ON TICK:
  MOVE PLAYER FORWARD
END

# Evento para cuando la serpiente come
ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  SPAWN FOOD AT RANDOM
END

# Eventos de fin de juego
ON COLLISION_WALL:
  GAME_OVER
END
ON COLLISION_SELF:
  GAME_OVER
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END