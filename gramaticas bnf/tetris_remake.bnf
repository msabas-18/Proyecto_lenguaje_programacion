<programa> ::= <tipo_juego> <grid> <definiciones> <eventos>

<tipo_juego> ::= "GAME_TYPE" "TETRIS"
<grid>       ::= "GAME_GRID" "(" <numero> "," <numero> ")"
<definiciones> ::= <definicion> | <definicion> <definiciones>
<eventos>    ::= <evento> | <evento> <eventos>

<definicion> ::= <definicion_shape> | <definicion_powerup>

# Los atributos COLOR y WEIGHT son opcionales y pueden ir en cualquier orden.
# WEIGHT define la probabilidad relativa de la figura en SPAWN RANDOM_SHAPE
# (seleccion ponderada). Si se omite vale 1. Debe haber al menos una figura con WEIGHT > 0.
<definicion_shape> ::= "DEFINE" "SHAPE" <identificador> ":" <atributos_shape> <estados> "END"
<atributos_shape>  ::= "" | <atributo_shape> <atributos_shape>
<atributo_shape>   ::= <atributo_color> | <atributo_weight>
<atributo_weight>  ::= "WEIGHT" ":" <numero>
<estados>          ::= <estado> | <estado> <estados>
<estado>           ::= "STATE" <numero> ":" <matriz>
<matriz>           ::= <fila> | <fila> <matriz>
<fila>             ::= "[" <valores_fila> "]"
<valores_fila>     ::= <numero> | <numero> "," <valores_fila>

# --- POWER-UPS (nuevo) ---
# Los atributos pueden ir en cualquier orden y debe haber al menos un STATE.
# Un archivo sin ningun POWERUP sigue siendo valido (retrocompatibilidad).
<definicion_powerup> ::= "DEFINE" "POWERUP" <identificador> ":" <items_powerup> "END"
<items_powerup>      ::= <item_powerup> | <item_powerup> <items_powerup>
<item_powerup>       ::= <atributo_color> | <atributo_efecto> | <atributo_when> | <atributo_param> | <estado>

<atributo_color>  ::= "COLOR" ":" <color_hex>
<atributo_efecto> ::= "EFFECT" ":" <efecto>
<atributo_when>   ::= "WHEN" ":" <tipo_condicion> <numero>
<atributo_param>  ::= <nombre_param> ":" <numero>

<efecto>          ::= "SLOW_DOWN"
<tipo_condicion>  ::= "LINES_CLEARED" | "PIECES_SPAWNED"
<nombre_param>    ::= "SLOW_DIV" | "DURATION"
<color_hex>       ::= "#" <hex> <hex> <hex> <hex> <hex> <hex>
<hex>             ::= <digito> | "A"..."F" | "a"..."f"

<evento>         ::= "ON" <nombre_evento_tetris> ":" <acciones_tetris> "END"
<nombre_evento_tetris> ::= "START" | "TICK" | "LINE_CLEAR" | "KEY_UP" | "KEY_DOWN" | "KEY_LEFT" | "KEY_RIGHT"
<acciones_tetris>    ::= <accion_tetris> | <accion_tetris> <acciones_tetris>

<accion_tetris> ::= <accion_spawn> | <accion_mover> | <accion_rotar> | <accion_puntos>
<accion_spawn>  ::= "SPAWN" "RANDOM_SHAPE"   # eleccion ponderada segun WEIGHT de cada figura
<accion_mover>  ::= "MOVE" "CURRENT_PIECE" <direccion>
<accion_rotar>  ::= "ROTATE" "CURRENT_PIECE"
<accion_puntos> ::= "INCREASE_SCORE" <numero>

<direccion>     ::= "LEFT" | "RIGHT" | "DOWN"
<identificador> ::= <letra> | <letra> <identificador>
<numero>        ::= <digito> | <digito> <numero>
<letra>         ::= "A"..."Z" | "_"
<digito>        ::= "0"..."9"
